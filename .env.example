# Application Environment
ENVIRONMENT=production
API_PORT=8000

# PostgreSQL Configuration
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=civicfix_production_db
POSTGRES_USER=civicfix_prod_user
POSTGRES_PASSWORD=replace_with_a_strong_64_character_hex_password_in_prod

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Security & JWT Configuration
JWT_SECRET_KEY=replace_with_a_cryptographically_secure_256_bit_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Media Upload Storage
STORAGE_BACKEND=local
MEDIA_UPLOAD_DIR=/app/uploads

# Nginx & Domain Configuration
DOMAIN_NAME=civicfix.gov
SSL_CERT_PATH=/etc/letsencrypt/live/civicfix.gov/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/civicfix.gov/privkey.pem
